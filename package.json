{
  "name": "agent-sprites",
  "version": "0.96.0",
  "description": "Pixel-art sprite authoring toolset for coding agents and 2D game projects",
  "type": "module",
  "main": "server/index.js",
  "bin": {
    "agent-sprites": "scripts/sprite.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "node scripts/test-ui.mjs",
    "test:ui:native": "node scripts/test-ui-native.mjs",
    "build:ui-fixture": "node scripts/build-ui-fixture.mjs"
  },
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3": true,
    "canvas": true
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "canvas": "^3.2.3",
    "express": "^5.2.1",
    "sharp": "^0.35.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "phaser": "4.2.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.3"
  }
}
