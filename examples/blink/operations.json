[
  { "command": "new", "name": "blink", "size": 16, "rows": 1, "cols": 2, "palette": "pico8" },
  { "command": "draw", "type": "rect", "cell": "0,0", "name": "body", "x": 4, "y": 3, "w": 8, "h": 10, "color": "#29adff", "filled": true },
  { "command": "draw", "type": "rect", "cell": "0,0", "name": "eye", "x": 9, "y": 5, "w": 2, "h": 2, "color": "#fff1e8", "filled": true },
  { "command": "clone-cell", "from": "0,0", "to": ["0,1"] },
